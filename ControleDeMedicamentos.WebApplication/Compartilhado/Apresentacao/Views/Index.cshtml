@{
    Layout = "_Layout";
    ViewBag.Titulo = "Página Inicial";
}

<div class="row align-items-center">
    <div class="col-lg-7">
        <h1 class="display-5 fw-bold mb-3">
            <i class="bi bi-capsule-pill me-2"></i>
            Controle De Medicamentos
        </h1>
        <p class="lead text-secondary mb-4">
            Gerencie medicamentos, pacientes, fornecedores e estoque em um único lugar. Controle entradas, saídas e
            disponibilidade de medicamentos com praticidade, organização e segurança.

        </p>
        <div class="d-flex gap-2 flex-wrap">
            <a class="btn btn-outline-primary rounded-pill px-4" asp-controller="" asp-action="Listar">
                Fornecedores
            </a>
            <a class="btn btn-outline-primary rounded-pill px-4" asp-controller="" asp-action="Listar">
                Pacientes
            </a>
            <a class="btn btn-outline-primary rounded-pill px-4" asp-controller="" asp-action="Listar">
                Medicamentos
            </a>
            <a class="btn btn-outline-primary rounded-pill px-4" asp-controller="" asp-action="Listar">
                Funcionários
            </a>
        </div>
    </div>

    <div class="col-lg-5 mt-4 mt-lg-0">
        <div class="card border-primary-subtle shadow-sm">
            <div class="card-body p-4">
                <h3 class="h5 text-primary mb-3">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor"
                         class="bi bi-grid me-2" viewBox="0 0 16 16">
                        <path
                        d="M1 2.5A1.5 1.5 0 0 1 2.5 1h3A1.5 0 0 1 7 2.5v3A1.5 1.5 0 0 1 5.5 7h-3A1.5 1.5 0 0 1 1 5.5v-3zM2.5 2a.5.5 0 0 0-.5.5v3a.5.5 0 0 0 .5.5h3a.5.5 0 0 0 .5-.5v-3a.5.5 0 0 0-.5-.5h-3zm6.5.5A1.5 1.5 0 0 1 10.5 1h3A1.5 0 0 1 15 2.5v3A1.5 1.5 0 0 1 13.5 7h-3A1.5 1.5 0 0 1 9 5.5v-3zm1.5-.5a.5.5 0 0 0-.5.5v3a.5.5 0 0 0 .5.5h3a.5.5 0 0 0 .5-.5v-3a.5.5 0 0 0-.5-.5h-3zM1 10.5A1.5 1.5 0 0 1 2.5 9h3A1.5 1.5 0 0 1 7 10.5v3A1.5 1.5 0 0 1 5.5 15h-3A1.5 1.5 0 0 1 1 13.5v-3zm1.5-.5a.5.5 0 0 0-.5.5v3a.5.5 0 0 0 .5.5h3a.5.5 0 0 0 .5-.5v-3a.5.5 0 0 0-.5-.5h-3zm6.5.5A1.5 1.5 0 0 1 10.5 9h3a1.5 0 0 1 1.5 1.5v3a1.5 1.5 0 0 1-1.5 1.5h-3A1.5 1.5 0 0 1 9 13.5v-3zm1.5-.5a.5.5 0 0 0-.5.5v3a.5.5 0 0 0 .5.5h3a.5.5 0 0 0 .5-.5v-3a.5.5 0 0 0-.5-.5h-3z" />
                    </svg>
                    Módulos disponíveis
                </h3>

                <div class="list-group list-group-flush">
                    <a class="list-group-item list-group-item-action d-flex justify-content-between align-items-center px-0"
                       asp-controller="" asp-action="Listar">
                        <span>
                            <i class="bi bi-building me-2"></i>
                            Fornecedores
                        </span>
                        <span class="badge text-bg-primary rounded-pill">Abrir</span>
                    </a>

                    <a class="list-group-item list-group-item-action d-flex justify-content-between align-items-center px-0"
                       asp-controller="" asp-action="Listar">
                        <span>
                            <i class="bi bi-person me-2"></i>
                            Pacientes
                        </span>
                        <span class="badge text-bg-primary rounded-pill">Abrir</span>
                    </a>

                    <a class="list-group-item list-group-item-action d-flex justify-content-between align-items-center px-0"
                       asp-controller="" asp-action="Listar">
                        <span>
                            <i class="bi bi-capsule-pill me-2"></i>
                            Medicamentos
                        </span>
                        <span class="badge text-bg-primary rounded-pill">Abrir</span>
                    </a>
                    <a class="list-group-item list-group-item-action d-flex justify-content-between align-items-center px-0"
                       asp-controller="" asp-action="Listar">
                        <span>
                            <i class="bi bi-person-badge me-2"></i>
                            Funcionários
                        </span>
                        <span class="badge text-bg-primary rounded-pill">Abrir</span>
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>