@{
    Layout = "_Layout";
    ViewBag.Titulo = "Exclusão de Paciente";
}

@model ExcluirPacienteViewModel

<div class="alert alert-primary border-start border-primary border-2 rounded-3" role="alert">
    Deseja mesmo excluir este paciente?
</div>

<form class="card border-primary-subtle shadow-sm mx-auto p-4" style="max-width: 620px;" asp-action="Excluir"
      asp-route-id=@Model.Id method="post">

    <h4 class="text-primary mb-4">Excluir Paciente</h4>

    <div class="mb-3">
        <label asp-for="Nome" class="form-label fw-semibold text-primary text-uppercase small">
            Nome
        </label>

        <input asp-for="Nome" type="text" class="form-control" disabled>

        <span asp-validation-for="Nome" class="text-danger small fw-semibold">
        </span>
    </div>

    <div class="mb-3">
        <label asp-for="Telefone" class="form-label fw-semibold text-primary text-uppercase small">
            Telefone
        </label>

        <input asp-for="Telefone" type="text" class="form-control" placeholder="EX: 47999999999" disabled>

        <span asp-validation-for="Telefone" class="text-danger small fw-semibold">
        </span>
    </div>

    <div class="mb-3">
        <label asp-for="CartaoSus" class="form-label fw-semibold text-primary text-uppercase small">
            Cartão Sus
        </label>

        <input asp-for="CartaoSus" type="text" class="form-control" placeholder="EX: 000000000000000" disabled>

        <span asp-validation-for="CartaoSus" class="text-danger small fw-semibold">
        </span>
    </div>

    <div class="mb-3">
        <label asp-for="Cpf" class="form-label fw-semibold text-primary text-uppercase small">
            CPF
        </label>

        <input asp-for="Cpf" type="text" class="form-control" placeholder="EX: 00000000000" disabled>

        <span asp-validation-for="Cpf" class="text-danger small fw-semibold">
        </span>
    </div>

    <div class="d-flex justify-content-end gap-2 mt-4">
        <a class="btn btn-outline-primary rounded-pill px-4" asp-action="Listar">
            Voltar
        </a>

        <button class="btn btn-success rounded-pill px-4" type="submit">
            Confirmar
        </button>
    </div>

</form>