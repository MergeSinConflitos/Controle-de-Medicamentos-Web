@{
    Layout = "_Layout";
    ViewBag.Titulo = "Cadastro de Saida de Estoque";
}

@model CadastrarEstoqueSaidaViewModel

<form class="card border-success-subtle shadow-sm mx-auto p-4" style="max-width: 620px;" asp-action="Cadastrar"
      method="post">

    <h4 class="text-success mb-4">Cadastrar Saida de Estoque</h4>

    <input asp-for="PacienteId" type="hidden" />

    <div class="mb-3">
        <label asp-for="MedicamentoId" class="form-label fw-semibold text-success text-uppercase small">
            Medicamento
        </label>

        <select asp-for="MedicamentoId" class="form-select">
            <option value="">Selecione um Medicamento</option>

            @foreach (OpcaoMedicamentoViewModel medicamento in Model.Medicamentos)
            {
                <option value="@medicamento.Id">
                    @medicamento.Nome
                </option>
            }
        </select>

        <span asp-validation-for="MedicamentoId" class="text-danger small fw-semibold"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Quantidade" class="form-label fw-semibold text-success text-uppercase small">
            Quantidade
        </label>

        <input asp-for="Quantidade" type="number" min="1" class="form-control">

        <span asp-validation-for="Quantidade" class="text-danger small fw-semibold"></span>
    </div>

    <div class="d-flex justify-content-end gap-2 mt-4">

        <a class="btn btn-outline-primary rounded-pill px-4" asp-action="Listar"
           asp-route-pacienteId="@Model.PacienteId">
            Voltar
        </a>

        <button class="btn btn-success rounded-pill px-4" type="submit">
            Confirmar
        </button>

    </div>
</form>
