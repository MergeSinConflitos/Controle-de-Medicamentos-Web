@{
    Layout = "_Layout";
    ViewBag.Titulo = "Saídas de Estoque";
}

@model GerenciarEstoqueSaidaViewModel

<a class="btn btn-outline-success rounded-pill px-4 mb-3" asp-action="Cadastrar"
   asp-route-pacienteId="@Model.PacienteId">

    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-plus-lg me-1"
         viewBox="0 0 16 16">
        <path fill-rule="evenodd"
              d="M8 2a.5.5 0 0 1 .5.5v5h5a.5.5 0 0 1 0 1h-5v5a.5.5 0 0 1-1 0v-5h-5a.5.5 0 0 1 0-1h5v-5A.5.5 0 0 1 8 2Z" />
    </svg>

    Nova Saída
</a>

<div class="alert alert-primary border-start border-primary border-4 rounded-3 mb-4">
    <strong>Paciente:</strong> @Model.PacienteNome
</div>

@if (TempData["MensagemErro"] is string mensagemErro)
{
    <div class="alert alert-danger border-start border-danger border-4 rounded-3">
        @mensagemErro
    </div>
}

@if (TempData["MensagemSucesso"] is string mensagemSucesso)
{
    <div class="alert alert-success border-start border-success border-4 rounded-3">
        @mensagemSucesso
    </div>
}

@if (!Model.Saidas.Any())
{
    <div class="alert alert-warning border-start border-warning border-2 rounded-3">
        Nenhuma saída registrada para este paciente.
    </div>
}
else
{
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">

        @foreach (var saida in Model.Saidas)
        {
            var idCurto = saida.Id.ToString("N")[..7];

            <div class="col">
                <div class="card h-100 shadow-sm border-0">

                    <div class="card-header bg-danger" style="height: 6px;"></div>

                    <div class="card-body">

                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <h6 class="mb-0">
                                Saída
                            </h6>

                            <span class="badge rounded-pill bg-secondary">
                                #@idCurto
                            </span>
                        </div>

                        <div class="mb-2">
                            <small class="text-muted">
                                <strong>Data:</strong> @saida.Data.ToString("dd/MM/yyyy")
                            </small>
                        </div>

                        <div class="mb-2">
                            <small class="text-muted">
                                <strong>Medicamento:</strong> @saida.MedicamentoNome
                            </small>
                        </div>

                        <div class="mb-2">
                            <small class="text-muted">
                                <strong>Quantidade:</strong> @saida.Quantidade
                            </small>
                        </div>

                    </div>

                </div>
            </div>
        }

    </div>
}

<style>
    .card:hover {
        transform: translateY(-4px);
        box-shadow: 0 8px 16px rgba(0, 0, 0, .15) !important;
    }
</style>