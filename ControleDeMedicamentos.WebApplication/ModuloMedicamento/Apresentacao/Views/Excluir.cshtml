@{
    Layout = "_Layout";
    ViewBag.Titulo = "Exclusão de Medicamento";
}

@model ExcluirMedicamentoViewModel

<div class="alert alert-primary border-start border-primary border-2 rounded-3" role="alert">
    Deseja mesmo excluir este medicamento?
</div>

<form class="card border-primary-subtle shadow-sm mx-auto p-4" style="max-width: 620px;" asp-action="Excluir"
      asp-route-id=@Model.Id method="post">

    <h4 class="text-primary mb-4">Excluir Medicamento</h4>

    <div class="mb-3">
        <label asp-for="Nome" class="form-label fw-semibold text-primary text-uppercase small">
            Nome
        </label>

        <input asp-for="Nome" type="text" class="form-control" disabled>

        <span asp-validation-for="Nome" class="text-danger small fw-semibold">
        </span>
    </div>

    <div class="mb-3">
        <label asp-for="Descricao" class="form-label fw-semibold text-primary text-uppercase small">
            Descrição
        </label>

        <textarea asp-for="Descricao" class="form-control" rows="4" disabled></textarea>

        <span asp-validation-for="Descricao" class="text-danger small fw-semibold">
        </span>
    </div>

    <div class="mb-3">
        <label asp-for="FornecedorId"
               class="form-label fw-semibold text-primary text-uppercase small">Fornecedor</label>
        <input asp-for="FornecedorNome" type="text" class="form-control" disabled>
        <span asp-validation-for="FornecedorId" class="text-danger small fw-semibold"></span>
    </div>

    <div class="d-flex justify-content-end gap-2 mt-4">
        <a class="btn btn-outline-primary rounded-pill px-4" asp-action="Listar">
            Voltar
        </a>

        <button class="btn btn-success rounded-pill px-4" type="submit">
            Confirmar
        </button>
    </div>
</form>