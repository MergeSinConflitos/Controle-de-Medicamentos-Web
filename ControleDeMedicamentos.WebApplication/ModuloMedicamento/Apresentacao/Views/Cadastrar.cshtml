@{
    Layout = "_Layout";
    ViewBag.Titulo = "Cadastro de Medicamento";
}

@model CadastrarMedicamentoViewModel

<form class="card border-primary-subtle shadow-sm mx-auto p-4" style="max-width: 620px;" asp-action="Cadastrar"
      method="post">

    <h4 class="text-primary mb-4">Cadastrar Medicamento</h4>

    <div class="mb-3">
        <label asp-for="Nome" class="form-label fw-semibold text-primary text-uppercase small">
            Nome
        </label>

        <input asp-for="Nome" type="text" class="form-control">

        <span asp-validation-for="Nome" class="text-danger small fw-semibold">
        </span>
    </div>

    <div class="mb-3">
        <label asp-for="Descricao" class="form-label fw-semibold text-primary text-uppercase small">
            Descrição
        </label>

        <textarea asp-for="Descricao" class="form-control" rows="4"></textarea>

        <span asp-validation-for="Descricao" class="text-danger small fw-semibold">
        </span>
    </div>

    <div class="mb-3">
        <label asp-for="FornecedorId"
               class="form-label fw-semibold text-primary text-uppercase small">Fornecedor</label>
        <select asp-for="FornecedorId" class="form-select">
            <option value="">Selecione um Fornecedor</option>
            @foreach (OpcaoFornecedorViewModel fornecedor in Model.Fornecedores)
            {
                <option value="@fornecedor.Id">@fornecedor.Nome</option>
            }
        </select>
        <span asp-validation-for="FornecedorId" class="text-danger small fw-semibold"></span>
    </div>

    <div class="d-flex justify-content-end gap-2 mt-4">
        <a class="btn btn-outline-primary rounded-pill px-4" asp-action="Listar">
            Voltar
        </a>

        <button class="btn btn-success rounded-pill px-4" type="submit">
            Confirmar
        </button>
    </div>

</form>